{
  "name": "prompt-intelligence-layer",
  "displayName": "Prompt Intelligence Layer",
  "description": "Optimize and enhance your prompts with intelligent analysis",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Prompt Intelligence",
        "properties": {
          "promptIntelligence.rules.VagueReference.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable VagueReference rule to detect vague pronouns"
          },
          "promptIntelligence.rules.MissingContext.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable MissingContext rule to detect missing context"
          },
          "promptIntelligence.rules.CompoundQuestion.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable CompoundQuestion rule to detect multiple questions"
          },
          "promptIntelligence.rules.VerbosePhrasing.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable VerbosePhrasing rule to detect verbose expressions"
          },
          "promptIntelligence.rules.InsufficientDetail.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable InsufficientDetail rule to detect lack of detail"
          },
          "promptIntelligence.confidenceThreshold": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence threshold for accepting suggestions (0-1)"
          },
          "promptIntelligence.maxPromptLength": {
            "type": "number",
            "default": 10000,
            "minimum": 1,
            "description": "Maximum allowed prompt length in characters"
          },
          "promptIntelligence.performanceTimeout": {
            "type": "number",
            "default": 200,
            "minimum": 1,
            "description": "Performance timeout for analysis in milliseconds"
          },
          "promptIntelligence.showPerformanceWarnings": {
            "type": "boolean",
            "default": true,
            "description": "Show warnings when analysis exceeds timeout"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "prompt-intelligence-layer.optimizePrompt",
        "title": "Optimize Prompt"
      }
    ],
    "keybindings": [
      {
        "command": "prompt-intelligence-layer.optimizePrompt",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "node esbuild.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --require ts-node/register test/unit/**/*.test.ts",
    "package": "vsce package"
  },
  "dependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.3.x",
    "esbuild": "^0.19.x",
    "eslint": "^8.x",
    "glob": "^10.x",
    "mocha": "^10.x",
    "@types/mocha": "^10.x",
    "ts-node": "^10.x",
    "typescript": "^5.3.x"
  }
}
